#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "${EUID}" -ne 0 ]] || ! command -v pct >/dev/null 2>&1; then
  echo "Dieses Skript muss als root auf einem Proxmox-VE-Host laufen." >&2
  exit 1
fi

ctid="${CTID:-120}"
hostname="${CT_HOSTNAME:-dpl-acron}"
root_storage="${ROOT_STORAGE:-local-lvm}"
template_storage="${TEMPLATE_STORAGE:-local}"
bridge="${BRIDGE:-vmbr0}"
ip_config="${IP_CONFIG:-dhcp}"
gateway="${GATEWAY:-}"

if pct status "$ctid" >/dev/null 2>&1; then
  echo "CT $ctid existiert bereits; es wurden keine Änderungen vorgenommen." >&2
  exit 1
fi

pveam update
template_name="$(pveam available --section system | awk '$2 ~ /^debian-13.*standard/ {print $2; exit}')"
if [[ -z "$template_name" ]]; then
  echo "Keine Debian-13-Systemvorlage gefunden. Bitte pveam available prüfen." >&2
  exit 1
fi

if ! pveam list "$template_storage" | grep -Fq "/$template_name"; then
  pveam download "$template_storage" "$template_name"
fi

network="name=eth0,bridge=$bridge,ip=$ip_config,firewall=1"
if [[ -n "$gateway" ]]; then
  network="$network,gw=$gateway"
fi

pct create "$ctid" "$template_storage:vztmpl/$template_name" \
  --hostname "$hostname" \
  --unprivileged 1 \
  --cores 2 \
  --memory 2048 \
  --swap 512 \
  --rootfs "$root_storage:8" \
  --net0 "$network" \
  --onboot 1 \
  --start 1 \
  --tags "dpl-acron;intranet"

echo "CT $ctid wurde als unprivilegierter Debian-13-Container erstellt."
echo "Nächster Schritt: MariaDB installieren und das DPL-Bundle mit pct push übertragen."
echo "Vor dem Zugriff die CT-Firewall auf die tatsächlichen LAN-/VPN-CIDRs begrenzen."
