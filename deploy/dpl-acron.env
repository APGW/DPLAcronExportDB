# Der Dienst lauscht auf der privaten CT-/VM-Adresse. Der Zugriff muss in
# Proxmox beziehungsweise der Unternehmensfirewall auf LAN- und VPN-Netze
# begrenzt werden. Keine Portweiterleitung aus dem Internet einrichten.
DPL_HOST=0.0.0.0
DPL_PORT=8765
# Abbruch langsamer oder unvollständiger HTTP-Anfragen. Zulässig: 10 bis 900 Sekunden.
DPL_REQUEST_TIMEOUT_SECONDS=120
